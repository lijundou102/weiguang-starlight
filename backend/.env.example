# 数据库连接（默认 SQLite，路径相对于 prisma/schema.prisma）
DATABASE_URL="file:./dev.db"

# JWT 签名密钥（生产环境务必替换为高强度随机串）
JWT_SECRET="change-me-to-a-long-random-string"

# AI 模式：auto（默认，配置了 LLM_API_KEY 即自动启用大模型，否则回退本地 fallback）| llm | mock
AI_PROVIDER="auto"

# 兼容 OpenAI 格式的大模型 API（如 DeepSeek / 通义千问 / OpenAI）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 后端服务端口
PORT=3001

# 允许跨域的前端域名（逗号分隔，生产环境填 Vercel 域名；本地留空默认允许 localhost）
CORS_ORIGIN="http://localhost:5173"

# 首次空库自动导入种子数据（生产环境首次上线设为 true，已有数据时绝不覆盖）
AUTO_SEED_IF_EMPTY="false"

# seed 管理员账号（可选，默认 admin / admin123456）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123456"
